# 日本語 Hub - Local Environment Configuration
# Copy this file to '.env' (which is ignored by Git) and enter your key:
# cp .env.example .env

# LLM Provider configuration for build-time AI lesson enrichment.
# Enter either your OpenAI API key OR your Gemini API key:

# Option A: OpenAI API Key (uses gpt-4o-mini by default)
# OPENAI_API_KEY=sk-proj-...

# Option B: Gemini API Key (uses gemini-2.5-flash by default)
# GEMINI_API_KEY=AIzaSy...

# Custom Model Selection (Optional)
# Specify model name. Prefixes "gpt-" route to OpenAI; "gemini-" route to Gemini.
# Examples:
# OpenAI:  gpt-4o, gpt-4o-mini (default), o1-mini
# Gemini:  gemini-2.5-flash (default), gemini-1.5-pro, gemini-1.5-flash
# AI_MODEL=gpt-4o-mini


